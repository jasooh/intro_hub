# Copy to .env.local for local dev, and add the same values in Vercel.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for OAuth redirects and links in emails)
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Toronto

# Comma-separated Google emails that become hosts (admins) on first sign-in
ADMIN_EMAILS=host@gmail.com

# Where players send e-Transfers (shown in payment instructions)
ETRANSFER_EMAIL=host@gmail.com

# Random secrets: generate each with `openssl rand -hex 32`
CRON_SECRET=
INGEST_SECRET=

# Optional: the host's Spotify playlist (open.spotify.com/playlist/...), embedded on the home page
SPOTIFY_PLAYLIST_URL=

# Email via Gmail SMTP (free). Needs 2-Step Verification + an App Password.
# Leave blank locally and emails are printed to the server log instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional
EMAIL_FROM=
EMAIL_REPLY_TO=
# Gmail's sending limit per 24 hours: 500 for a personal Gmail, 2000 for Google Workspace.
# The host panel warns as it gets close, and pauses + queues emails if Gmail refuses.
EMAIL_DAILY_LIMIT=500

# Only for `npm run db:status` (read-only checks of which migrations are applied). Never used by the app.
# Supabase > Project Settings > Database > Connection string > Session pooler, with the password filled in.
DEV_DB_URL=
PROD_DB_URL=
