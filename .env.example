# Copy to .env.local for local dev, and add the same values in Vercel.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for OAuth redirects and links in emails)
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Toronto

# Comma-separated Google emails that become hosts (admins) on first sign-in
ADMIN_EMAILS=host@gmail.com

# Where players send e-Transfers (shown in payment instructions)
ETRANSFER_EMAIL=host@gmail.com

# Random secrets: generate each with `openssl rand -hex 32`
CRON_SECRET=
INGEST_SECRET=

# Email: set ONE of these. With neither, emails are printed to the server log.
# Option 1: Gmail SMTP (free). Needs 2-Step Verification + an App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option 2: Resend (free tier). Needs a verified domain to email anyone but yourself.
RESEND_API_KEY=
# Optional
EMAIL_FROM=
EMAIL_REPLY_TO=
